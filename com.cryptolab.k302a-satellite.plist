<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
    "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  com.cryptolab.k302a-satellite.plist
  K302a Satellite Paper-Trade Daily Runner (launchctl daemon) — v6.12

  Architecture: K302a = K280 main (80%) + K297 PAXG/SPX satellite (20%)
    Satellite: PAXG 60% + SPX 40% — HyperLiquid only (HIP-3 RWA perps)
    Total exchanges: 2 (Bybit + HyperLiquid)

  REPLACES: com.cryptolab.k287-satellite.plist (K270 dYdX + K275 OKX)
  K289 scaffold retained as 60d rollback (plist disabled, not deleted).

  Backtest reference (K297 always-on carry portfolio):
    PAXG: Sh=16.91, MaxDD=-0.36%, Win Days 88%, Ann Return 8.03%
    SPX:  Sh= 5.87, MaxDD=-1.74%, Win Days 78%, Ann Return 6.80%
    Portfolio (EW): Sh=10.17, MaxDD=-1.41%, Ann Return ~7.3%
    Combined K302a (K280 80% + satellite 20%): Sh=32.59

  Cost model (K296 finding):
    HL maker: 0.015%/side = 1.5 bp (actual)
    HL taker: 0.045%/side = 4.5 bp (actual)
    Paper-trade: 7 bp/side (conservative safety margin)

  K303 monitoring triggers:
    HL API latency > 500ms × 3 checks → ALERT
    K302a satellite daily DD < -0.5%  → HALT satellite
    Combined 30d rolling Sh < 25.0    → re-evaluate architecture
    K302a 55d Sh < 28.0               → revert to K287d

  Schedule: 09:30 JST = 00:30 UTC daily
    30 min after K280 main (09:00 JST) to avoid simultaneous HL API calls.
    Step 1: k302a_satellite_fetch.py  (incremental PAXG/SPX FR fetch from HL)
    Step 2: k302a_satellite_run.py    (PAXG+SPX carry signals + satellite dashboard)

  Parallel daemon: com.cryptolab.k280-live.plist (K280 main, 09:00 JST)
  Both write to separate log files — no conflict.

  Install:
    cp /Users/nekonaomichi/crypto-lab/com.cryptolab.k302a-satellite.plist \
       ~/Library/LaunchAgents/
    launchctl load ~/Library/LaunchAgents/com.cryptolab.k302a-satellite.plist

  Uninstall:
    launchctl unload ~/Library/LaunchAgents/com.cryptolab.k302a-satellite.plist
    rm ~/Library/LaunchAgents/com.cryptolab.k302a-satellite.plist

  Monitor:
    tail -f /Users/nekonaomichi/crypto-lab/logs/k302a_satellite.log
    tail -f /Users/nekonaomichi/crypto-lab/logs/k302a_satellite_err.log

  Manual trigger:
    /Users/nekonaomichi/crypto-lab/.venv311/bin/python3 \
        /Users/nekonaomichi/crypto-lab/scripts/k302a_satellite_fetch.py --force
    /Users/nekonaomichi/crypto-lab/.venv311/bin/python3 \
        /Users/nekonaomichi/crypto-lab/scripts/k302a_satellite_run.py

  Exchange Risk (K303 assessment):
    HL concentration: 60% of total capital (K280 HL + K302a satellite on HL)
    Bybit: 40% of total capital (K280 Bybit component)
    Alert: HL_EXCHANGE_ERROR fires if HL API unreachable at fetch time.
    Mitigation: HL has 400+ day proven track record in K280 production (K303 rationale).
    dYdX, OKX counterparty risks eliminated vs K287d.
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.cryptolab.k302a-satellite</string>

    <!-- Run fetch + daily_run as a sequential shell script -->
    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>-c</string>
        <string>
PYTHON=/Users/nekonaomichi/crypto-lab/.venv311/bin/python3
BASE=/Users/nekonaomichi/crypto-lab

echo "=== K302a Satellite Run: $(date -u) ===" >> $BASE/logs/k302a_satellite.log

# Step 1: Incremental fetch (PAXG + SPX FR from HyperLiquid)
$PYTHON $BASE/scripts/k302a_satellite_fetch.py >> $BASE/logs/k302a_satellite.log 2>> $BASE/logs/k302a_satellite_err.log
FETCH_EXIT=$?

if [ $FETCH_EXIT -ne 0 ]; then
  echo "FETCH FAILED (exit $FETCH_EXIT) — continuing with cached data" >> $BASE/logs/k302a_satellite.log
fi

# Step 2: Compute satellite signals + update k302a_satellite_dashboard.json
$PYTHON $BASE/scripts/k302a_satellite_run.py >> $BASE/logs/k302a_satellite.log 2>> $BASE/logs/k302a_satellite_err.log
RUN_EXIT=$?

echo "=== Done: fetch=$FETCH_EXIT run=$RUN_EXIT ===" >> $BASE/logs/k302a_satellite.log
        </string>
    </array>

    <!-- 09:30 JST = 00:30 UTC (30 min after K280 main at 00:00 UTC) -->
    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>0</integer>
        <key>Minute</key>
        <integer>30</integer>
    </dict>

    <!-- Log paths (separate from K280 main and K287 satellite) -->
    <key>StandardOutPath</key>
    <string>/Users/nekonaomichi/crypto-lab/logs/k302a_satellite.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/nekonaomichi/crypto-lab/logs/k302a_satellite_err.log</string>

    <!-- Do not run immediately at load (run only at scheduled time) -->
    <key>RunAtLoad</key>
    <false/>

    <!-- One-shot per schedule, not a keep-alive daemon -->
    <key>KeepAlive</key>
    <false/>

    <!-- Working directory -->
    <key>WorkingDirectory</key>
    <string>/Users/nekonaomichi/crypto-lab</string>
</dict>
</plist>
