<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
    "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  com.cryptolab.k272a-live.plist
  K272a v6.10.1 Paper-Trade Daily Runner (launchctl daemon)

  Architecture: K198 + K208 + K265 (3-way, K226 DROPPED per K272 validation)
  Backtest OOS Sharpe: 16.13 | WF min: 9.92 | MaxDD: -0.000036

  Schedule: 09:00 JST daily = 00:00 UTC
    Step 1: k272a_live_fetch.py  (fetch live data: K208 spreads, K265 longtail, HLP balance)
    Step 2: k272a_daily_run.py   (compute signals + update k272a_live_dashboard.json)

  Install:
    cp /Users/nekonaomichi/crypto-lab/com.cryptolab.k272a-live.plist \
       ~/Library/LaunchAgents/
    launchctl load ~/Library/LaunchAgents/com.cryptolab.k272a-live.plist

  Uninstall:
    launchctl unload ~/Library/LaunchAgents/com.cryptolab.k272a-live.plist
    rm ~/Library/LaunchAgents/com.cryptolab.k272a-live.plist

  Monitor:
    tail -f /Users/nekonaomichi/crypto-lab/logs/k272a_live.log
    tail -f /Users/nekonaomichi/crypto-lab/logs/k272a_live_err.log

  Manual trigger:
    /Users/nekonaomichi/crypto-lab/.venv311/bin/python3 \
        /Users/nekonaomichi/crypto-lab/scripts/k272a_live_fetch.py --force
    /Users/nekonaomichi/crypto-lab/.venv311/bin/python3 \
        /Users/nekonaomichi/crypto-lab/scripts/k272a_daily_run.py

  K246a legacy (K250 scaffold) still runs via com.cryptolab.k246a-live.plist.
  Both can coexist: K246a log = k246a_live.log, K272a log = k272a_live.log.
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.cryptolab.k272a-live</string>

    <!-- Run fetch + daily_run as a sequential shell script -->
    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>-c</string>
        <string>
PYTHON=/Users/nekonaomichi/crypto-lab/.venv311/bin/python3
BASE=/Users/nekonaomichi/crypto-lab

echo "=== K272a Live Run: $(date -u) ===" >> $BASE/logs/k272a_live.log

# Step 1: Fetch live data (K208 spreads, K265 longtail panel, HLP balance)
$PYTHON $BASE/scripts/k272a_live_fetch.py >> $BASE/logs/k272a_live.log 2>> $BASE/logs/k272a_live_err.log
FETCH_EXIT=$?

if [ $FETCH_EXIT -ne 0 ]; then
  echo "FETCH FAILED (exit $FETCH_EXIT)" >> $BASE/logs/k272a_live.log
fi

# Step 2: Compute daily signals + update dashboard (proceeds even if fetch partial)
$PYTHON $BASE/scripts/k272a_daily_run.py >> $BASE/logs/k272a_live.log 2>> $BASE/logs/k272a_live_err.log
RUN_EXIT=$?

echo "=== Done: fetch=$FETCH_EXIT run=$RUN_EXIT ===" >> $BASE/logs/k272a_live.log
        </string>
    </array>

    <!-- 09:00 JST = 00:00 UTC -->
    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>0</integer>
        <key>Minute</key>
        <integer>0</integer>
    </dict>

    <!-- Log paths -->
    <key>StandardOutPath</key>
    <string>/Users/nekonaomichi/crypto-lab/logs/k272a_live.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/nekonaomichi/crypto-lab/logs/k272a_live_err.log</string>

    <!-- Do not run immediately at load (run only at scheduled time) -->
    <key>RunAtLoad</key>
    <false/>

    <!-- One-shot per schedule, not a keep-alive daemon -->
    <key>KeepAlive</key>
    <false/>

    <!-- Working directory -->
    <key>WorkingDirectory</key>
    <string>/Users/nekonaomichi/crypto-lab</string>
</dict>
</plist>
