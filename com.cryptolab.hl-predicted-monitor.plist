<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
    "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  com.cryptolab.hl-predicted-monitor.plist
  HL predictedFundings Live Monitor (K304 scaffold)

  Purpose:
    Poll HL predictedFundings API every 5 minutes (288 calls/day).
    Save rolling 24h parquet cache (~50KB per snapshot × 288 = ~14MB/day).
    Emit dashboard JSON at data/hl_predicted_fr_dashboard.json.

  Alert coverage:
    K208 (SOL/XRP/SUI/OP/APT/AXS/JTO/IMX/SAND/ADA):
      pred_bybit_fr - pred_hl_fr extreme deviation → spread entry signal.
    K265/K276b (35/20 HL alts):
      Predicted FR ranking change vs prior snapshot → rebalance trigger.
    K297 RWA (XAG/XAU/SPX/PAXG/NQ):
      FR sign tracking — positive = short carry live.

  Rate limit etiquette:
    5-min interval = 288 POST calls/day.
    HL public info endpoint; no API key required.
    Each call: single JSON body, ~3-10KB response, <1s round-trip.
    Nominal HL guidance: 1 req/5s for info endpoints (this runs at 1 req/5min).

  Install:
    cp /Users/nekonaomichi/crypto-lab/com.cryptolab.hl-predicted-monitor.plist \
       ~/Library/LaunchAgents/
    launchctl load ~/Library/LaunchAgents/com.cryptolab.hl-predicted-monitor.plist

  Uninstall:
    launchctl unload ~/Library/LaunchAgents/com.cryptolab.hl-predicted-monitor.plist
    rm ~/Library/LaunchAgents/com.cryptolab.hl-predicted-monitor.plist

  Manual trigger (single shot):
    /Users/nekonaomichi/crypto-lab/.venv311/bin/python3 \
        /Users/nekonaomichi/crypto-lab/scripts/hl_predicted_fr_monitor.py

  Monitor logs:
    tail -f /Users/nekonaomichi/crypto-lab/logs/hl_predicted_fr_monitor.log
    tail -f /Users/nekonaomichi/crypto-lab/logs/hl_predicted_fr_monitor_err.log

  Dashboard:
    cat /Users/nekonaomichi/crypto-lab/data/hl_predicted_fr_dashboard.json | jq .

  Restart after script changes:
    launchctl unload ~/Library/LaunchAgents/com.cryptolab.hl-predicted-monitor.plist
    launchctl load   ~/Library/LaunchAgents/com.cryptolab.hl-predicted-monitor.plist

  Parallel to: com.cryptolab.k280-live.plist (09:00 JST)
               com.cryptolab.k287-satellite.plist (09:30 JST)
  No conflicts: this daemon writes separate cache/ and data/ files.

  Future:
    K310+ may read data/hl_predicted_fr_dashboard.json for signal enhancement.
    Upgrade to sub-minute polling if K310+ identifies time-critical spread windows.
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.cryptolab.hl-predicted-monitor</string>

    <!-- Single-shot Python script; launchctl fires it every 5 minutes -->
    <key>ProgramArguments</key>
    <array>
        <string>/Users/nekonaomichi/crypto-lab/.venv311/bin/python3</string>
        <string>/Users/nekonaomichi/crypto-lab/scripts/hl_predicted_fr_monitor.py</string>
    </array>

    <!-- 5-minute interval: fires at :00, :05, :10, ..., :55 of every hour -->
    <key>StartInterval</key>
    <integer>300</integer>

    <!-- Standard log paths (separate from all other daemons) -->
    <key>StandardOutPath</key>
    <string>/Users/nekonaomichi/crypto-lab/logs/hl_predicted_fr_monitor.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/nekonaomichi/crypto-lab/logs/hl_predicted_fr_monitor_err.log</string>

    <!-- Run immediately when loaded (first snapshot at install time) -->
    <key>RunAtLoad</key>
    <true/>

    <!-- One-shot per schedule; do not keep alive between runs -->
    <key>KeepAlive</key>
    <false/>

    <!-- Working directory -->
    <key>WorkingDirectory</key>
    <string>/Users/nekonaomichi/crypto-lab</string>

    <!-- Environment: ensure PATH is usable inside launchd context -->
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
        <key>PYTHONUNBUFFERED</key>
        <string>1</string>
    </dict>
</dict>
</plist>
