+# ── K742 / K492-C: FR Persistence Filter (Soft Monotonic Gate) ───────────────
+# Ref: wave_k492_k208_signal_refinement.md §3, wave_k742_k492c_ready.md
+# Hypothesis: FR autocorrelation AR(1) ~0.73 across K208 symbols. Entries where
+# HL-Bybit FR spread has been consistently positive for ≥2 of last 3 8h periods
+# show materially higher win rates (+2.31pp net after 32% FN loss).
+#
+# Gate (soft monotonic):
+#   PASS if: spread_now > 0
+#            AND (spread_t-1 > 0 OR spread_t-2 > 0)   [2-of-3 positive]
+#            AND gradient >= 0                          [not collapsing]
+# On cache miss → gate skips (returns True, conservative: never blocks on stale).
+#
+# ACTIVATION: set PERSISTENCE_ENABLED = True (the single 1-flip toggle).
+# Default False → zero behaviour change in PAPER_TRADE mode.
+# REVERT: set False, or: git apply -R wave_k742_k492c_ready.diff
+#
+# Expected lift: OOS Sh +1.51 | win rate +2.31pp | +$45K/yr @$10M K280 sleeve
+PERSISTENCE_ENABLED = False   # K742/K492-C: ← flip to True for live activation
+
+
+def check_fr_persistence(sym: str, hl_series: pd.Series, bybit_series: pd.Series,
+                          n_periods: int = 3, min_positive: int = 2) -> bool:
+    """
+    K492-C soft persistence gate. Returns True (allow entry) when spread has been
+    positive in >= min_positive of the last n_periods 8h settlements AND gradient
+    is non-negative (spread not collapsing). Falls back True on any data error.
+    No-op (returns True) when PERSISTENCE_ENABLED=False.
+    """
+    if not PERSISTENCE_ENABLED:
+        return True
+    try:
+        if hl_series.empty or bybit_series.empty:
+            return True  # no data — skip gate conservatively
+        by_tz = _normalize_tz(bybit_series)
+        hl_8h = (_normalize_tz(hl_series)
+                 .resample("8h", label="right", closed="right")
+                 .sum(min_count=1))
+        spread = (by_tz - hl_8h.reindex(by_tz.index)).dropna()
+        if len(spread) < n_periods:
+            return True  # insufficient history — skip gate
+        recent = spread.iloc[-n_periods:]
+        positive_count = int((recent > 0).sum())
+        gradient_ok = float(spread.iloc[-1]) >= float(spread.iloc[-2])
+        return positive_count >= min_positive and gradient_ok
+    except Exception:
+        return True  # any error → conservative pass (never block on exception)

