        <key>PYTHONUNBUFFERED</key>
        <string>1</string>
    </dict>

    <key>StandardOutPath</key>
    <string>logs/k739_fil_sol.log</string>

    <key>StandardErrorPath</key>
    <string>logs/k739_fil_sol.err</string>

    <key>RunAtLoad</key>
    <false/>

    <key>KeepAlive</key>
    <false/>

