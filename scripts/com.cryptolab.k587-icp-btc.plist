<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.cryptolab.k587-icp-btc</string>

    <key>ProgramArguments</key>
    <array>
        <string>/usr/bin/python3</string>
        <string>REPO_ROOT/scripts/k587_icp_btc_run.py</string>
        <string>--dry-run</string>
    </array>

    <key>StartInterval</key>
    <integer>28800</integer>

    <key>RunAtLoad</key>
    <false/>

    <key>StandardOutPath</key>
    <string>REPO_ROOT/logs/k587_icp_btc.log</string>

    <key>StandardErrorPath</key>
    <string>REPO_ROOT/logs/k587_icp_btc.err</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PAPER_TRADE</key>
        <string>True</string>
    </dict>

    <key>WorkingDirectory</key>
    <string>REPO_ROOT</string>
</dict>
</plist>
